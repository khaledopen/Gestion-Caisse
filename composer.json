{
  "name": "jenifer/gestion-caisse",
  "type": "project",
  "license": "proprietary",
  "description": "Gestion de caisse en français",
  "require": {"php": "^8.2", "laravel/framework": "^12.0", "laravel/tinker": "^2.10", "barryvdh/laravel-dompdf": "^3.1", "maatwebsite/excel": "^3.1.64"},
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/breeze": "^2.3",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php artisan test"},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable", "prefer-stable": true
}
